{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:bugs": "biome lint --diagnostic-level=error . && oxlint web-app sdk .github/scripts scripts/ci scripts/review scripts/roadmap",
    "lint:bugs:prune": "oxlint --prune-suppressions web-app sdk .github/scripts scripts/ci scripts/review scripts/roadmap",
    "format": "turbo format",
    "format:docs": "prettier --write \"docs/**/*.{md,mdx}\"",
    "format:docs:check": "prettier --check \"docs/**/*.{md,mdx}\"",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "name": "oxy",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
