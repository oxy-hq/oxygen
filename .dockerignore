# Ignore node_modules and build artifacts
node_modules/
dist/
web-app/node_modules/
web-app/dist/

# Ignore Rust target directory
target/

# Ignore version control and metadata files
.git/
.gitignore

# Ignore editor and IDE files
*.swp
*.swo
*.idea/
.vscode/
*.log

# Ignore Docker-related files
Dockerfile
Dockerfile.*
.dockerignore

# Ignore temporary files
*.tmp
*.bak
*.old

# Ignore OS-specific files
.DS_Store
Thumbs.db

docker-compose*.yml

# examples, because we will mount them later
examples/

# unnecessary files & folders
json-schemas/
.github/
internal-docs/
scripts/
# Not consumed by any build stage, but it sits in the context, so editing it
# invalidates `COPY . .` and costs a full release rebuild of the workspace —
# ~25 minutes to ship a change the image cannot even observe.
justfile
tests/
assets/
sdk/
# ...but the build needs two things out of it, and finding that out took two
# failed builds: the pnpm workspace manifests, and the three custom-app
# templates `crates/app/src/custom_app_template/registry.rs` embeds with
# `include_dir!`. Excluding either fails the build, which is how you learn no
# workflow has ever built this image.
!sdk/*/package.json
!sdk/create-oxy-app/templates/**
.claude/
.husky/
.turbo/
.playwright-mcp/


# tests
crates/app/tests/
crates/core/tests/
crates/semantic/tests/

# markdowns
docs/
**/*.md
# ...except the four the Rust build embeds with `include_str!`. Excluding them
# makes `cargo build` fail on a missing file, which is how you learn nothing has
# ever built this image.
!crates/agentic/builder/knowledge/*.md
!crates/app/src/cli/commands/apidoc.md

# log
*.log

# config files not needed for build
.env*
.lintstagedrc.js
.prettierignore
.prettierrc.js
.tool-versions
cliff.toml
commitlint.config.js
CLAUDE.md
turbo.json
biome.json