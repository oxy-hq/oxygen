{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TestFileConfig",
  "type": "object",
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/TestCase"
      }
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "settings": {
      "default": {
        "concurrency": 5,
        "runs": 3,
        "judge_model": null,
        "grader": "judge",
        "database": null
      },
      "allOf": [
        {
          "$ref": "#/definitions/TestSettings"
        }
      ]
    },
    "target": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ExpectQuerySource": {
      "description": "Which code path produced the SQL the answer rests on.",
      "type": "string",
      "enum": [
        "semantic",
        "llm",
        "vendor",
        "verified_sql"
      ]
    },
    "Grader": {
      "description": "How a case's answer is graded.",
      "oneOf": [
        {
          "description": "LLM-as-judge compares the answer text with `expected`.",
          "type": "string",
          "enum": [
            "judge"
          ]
        },
        {
          "description": "Run the agent's final SQL and `expected_sql` against `database`, compare result sets.",
          "type": "string",
          "enum": [
            "execution"
          ]
        }
      ]
    },
    "TestCase": {
      "type": "object",
      "required": [
        "prompt"
      ],
      "properties": {
        "expect": {
          "description": "Behaviours the run must show, checked from its events.",
          "anyOf": [
            {
              "$ref": "#/definitions/TestExpect"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected": {
          "default": "",
          "type": "string"
        },
        "expected_sql": {
          "description": "Gold SQL for the execution grader.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "prompt": {
          "type": "string"
        },
        "tags": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tool": {
          "description": "Optional: assert that this tool was invoked (deterministic check). Shorthand for `expect.tools: [<tool>]`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "TestExpect": {
      "description": "Behaviours the run must show. Every field is optional; an unset field is not checked, and a case fails when any set field is unmet.",
      "type": "object",
      "properties": {
        "asks_user": {
          "description": "`true`: the run must stop to ask the user a clarifying question. `false`: it must answer.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "chart": {
          "description": "Whether the run must (`true`) or must not (`false`) draw a chart.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "preagg": {
          "description": "Whether a successful query must (`true`) or must not (`false`) be served from a pre-aggregation.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "query_source": {
          "description": "The source of the query the answer rests on.",
          "anyOf": [
            {
              "$ref": "#/definitions/ExpectQuerySource"
            },
            {
              "type": "null"
            }
          ]
        },
        "tools": {
          "description": "Tools the run must call, by name.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "TestSettings": {
      "type": "object",
      "properties": {
        "concurrency": {
          "default": 5,
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "database": {
          "description": "Database the execution grader runs both queries against.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "grader": {
          "default": "judge",
          "allOf": [
            {
              "$ref": "#/definitions/Grader"
            }
          ]
        },
        "judge_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "runs": {
          "default": 3,
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    }
  }
}