{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TestFileConfig",
  "type": "object",
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/TestCase"
      }
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "settings": {
      "default": {
        "concurrency": 5,
        "runs": 3,
        "judge_model": null,
        "grader": "judge",
        "database": null
      },
      "allOf": [
        {
          "$ref": "#/definitions/TestSettings"
        }
      ]
    },
    "target": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Grader": {
      "description": "How a case's answer is graded.",
      "oneOf": [
        {
          "description": "LLM-as-judge compares the answer text with `expected`.",
          "type": "string",
          "enum": [
            "judge"
          ]
        },
        {
          "description": "Run the agent's final SQL and `expected_sql` against `database`, compare result sets.",
          "type": "string",
          "enum": [
            "execution"
          ]
        }
      ]
    },
    "TestCase": {
      "type": "object",
      "required": [
        "prompt"
      ],
      "properties": {
        "expected": {
          "default": "",
          "type": "string"
        },
        "expected_sql": {
          "description": "Gold SQL for the execution grader.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "prompt": {
          "type": "string"
        },
        "tags": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tool": {
          "description": "Optional: assert that this tool was invoked (deterministic check). TODO: implement tool-use verification in the eval pipeline.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "TestSettings": {
      "type": "object",
      "properties": {
        "concurrency": {
          "default": 5,
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "database": {
          "description": "Database the execution grader runs both queries against.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "grader": {
          "default": "judge",
          "allOf": [
            {
              "$ref": "#/definitions/Grader"
            }
          ]
        },
        "judge_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "runs": {
          "default": 3,
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    }
  }
}