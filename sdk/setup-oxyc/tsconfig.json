{
  // Nothing is compiled: the action runs the `.mjs` files in `src/` as they
  // are committed. This config exists so `tsc` can CHECK them, from the JSDoc
  // annotations, without a build step ever standing between the reviewed
  // source and what the runner executes.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.mjs", "test/**/*.mjs"]
}
