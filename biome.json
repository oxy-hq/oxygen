{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "single",
      "trailingCommas": "none",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "css": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2
    },
    "linter": {
      "enabled": true
    },
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  },
  "yaml": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "playwright": "none"
    },
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "recommended",
        "useButtonType": "warn",
        "useKeyWithClickEvents": "warn",
        "noStaticElementInteractions": "warn",
        "noSvgWithoutTitle": "warn",
        "useSemanticElements": "warn",
        "useValidAnchor": "warn",
        "useFocusableInteractive": "warn",
        "useAltText": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error",
        "noComponentHookFactories": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "warn",
        "noImplicitAnyLet": "error",
        "useIterableCallbackReturn": "warn",
        "noAssignInExpressions": "warn",
        "noShadowRestrictedNames": "warn",
        "noRedeclare": "warn",
        "noDocumentCookie": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useImportType": "warn",
        "useTemplate": "off"
      },
      "complexity": {
        "noStaticOnlyClass": "off",
        "noUselessFragments": "off"
      },
      "performance": {
        "noAccumulatingSpread": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error"
      },
      "nursery": {
        "useTailwindSortedClasses": "off"
      }
    }
  },
  "files": {
    "includes": [
      "*.json",
      "*.js",
      "*.ts",
      "web-app/**",
      "sdk/typescript/**",
      ".github/scripts/**",
      "sdk/cli/**",
      "sdk/setup-oxyc/**",
      "scripts/ci/**",
      "scripts/review/**",
      "scripts/roadmap/**",
      "!sdk/cli/template",
      "!sdk/cli/skills",
      "!sdk/typescript/src/testing/shape-zoo.json",
      "!oxlint-suppressions.json",
      "!**/dist",
      "!**/node_modules",
      "!**/styled-system",
      "!**/crates",
      "!**/docs",
      "!**/target",
      "!**/.claude",
      "!**/json-schemas",
      "!web-app/.agents"
    ]
  },
  "overrides": [
    {
      "includes": ["web-app/tests/**", "web-app/playwright*.config.ts"],
      "linter": {
        "domains": {
          "playwright": "recommended"
        }
      }
    }
  ],
  "tailwind": {
    "stylesheet": "./web-app/src/styles/shadcn/index.css",
    "attributes": ["class", "className", "classList"],
    "mergeFunctions": ["clsx", "cn", "tw"],
    "variantFunctions": ["cva"]
  }
}
